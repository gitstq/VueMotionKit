{
  "name": "vue-motion-kit",
  "version": "1.0.0",
  "description": "A Vue 3 creative animation component library with CSS-first animations",
  "type": "module",
  "main": "./dist/vue-motion-kit.cjs",
  "module": "./dist/vue-motion-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-motion-kit.js",
      "require": "./dist/vue-motion-kit.cjs"
    },
    "./styles": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite serve playground",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "keywords": [
    "vue3",
    "animation",
    "components",
    "motion",
    "creative",
    "ui",
    "vue",
    "css-animations",
    "transitions",
    "particles",
    "text-effects",
    "parallax",
    "tilt",
    "confetti"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": ""
}
